# EVCharge-Opt Environment Configuration Template
# Copy this file to .env and customize for your environment.

# Application Settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8002
LOG_LEVEL=INFO

# Database Connection
# Local SQLite development default (zero external dependency):
DATABASE_URL=sqlite:///./evcharge_opt.db
# PostgreSQL production/local alternative:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/evcharge_opt

# Forecast / Predictor Integration
# Modes: "mock" (default, deterministic offline fixtures) or "live" (HTTP calls to EVCharge-Predict)
PREDICT_PROVIDER_MODE=mock
PREDICT_API_BASE_URL=http://127.0.0.1:8001
PREDICT_SERVICE_TOKEN=replace_with_backend_service_token
PREDICT_TIMEOUT_SECONDS=10.0

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Frontend Configuration (for frontend/.env)
VITE_API_BASE_URL=http://127.0.0.1:8002
